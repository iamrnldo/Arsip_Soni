# Salin menjadi server/.env. DATABASE_URL bisa dipakai sebagai alternatif PG*.
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=<PASSWORD_POSTGRES>
PGDATABASE=kediri_desa
PGMAINTENANCE_DATABASE=postgres
JWT_SECRET=<MINIMUM_32_RANDOM_CHARACTERS>
JWT_EXPIRES_IN=8h
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=26214400
# Admin bootstrap runs only when the database has no admin account.
BOOTSTRAP_ADMIN_NAME=Administrator Desa
BOOTSTRAP_ADMIN_EMAIL=admin@desakediri.id
BOOTSTRAP_ADMIN_PASSWORD=<MINIMUM_12_CHARACTERS>
# Optional Google Calendar read-only service account configuration
GOOGLE_CALENDAR_ID=<CALENDAR_ID>
GOOGLE_CLIENT_EMAIL=<SERVICE_ACCOUNT_EMAIL>
GOOGLE_PRIVATE_KEY=<SERVICE_ACCOUNT_PRIVATE_KEY_WITH_ESCAPED_NEWLINES>
